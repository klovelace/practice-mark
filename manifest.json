{
  "manifest_version": 3,
  "name": "Practice Mark for YouTube",
  "version": "0.4.14",
  "description": "Mark moments, build practice loops, slow them down, and control YouTube hands-free with voice.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Practice Mark",
    "default_icon": {
      "128": "glyph-mark.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "voice-log.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "mark": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "MacCtrl+Shift+M"
      },
      "description": "Capture the next sequential mark"
    },
    "again": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Restart the active loop"
    },
    "toggle-loop": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Toggle the active practice loop"
    },
    "next-loop": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "MacCtrl+Shift+N"
      },
      "description": "Practice the next loop"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "glyph-mark.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "short_name": "PracticeMark",
  "icons": {
    "128": "glyph-mark.png"
  }
}
